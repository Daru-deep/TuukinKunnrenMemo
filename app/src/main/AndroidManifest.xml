<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 地図のタイル取得（OpenStreetMap） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ルート記録 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      画面を消しても記録を続けるためのフォアグラウンドサービス。
      ACCESS_BACKGROUND_LOCATION は使っていない。
      アプリを開いている状態から開始したフォアグラウンドサービスなら不要で、
      「常に許可」を求めない方がユーザーにとっても安全なため。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Android 13以降、通知を出すには許可が要る（記録中の通知に使う） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      「電池の最適化から除外しますか？」のダイアログを直接出すためのもの。
      端末の設定画面を開くだけで、除外するかどうかを決めるのは利用者。
      通勤のあいだ1時間ほど記録を続けるので、最適化に任せたままだと
      画面を消している間にサービスを止められてしまう。
      ※Google Playで配る場合はこの権限の用途を申告する必要がある。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".CommuteApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.CommuteMemo"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false">
        <!--
          allowBackup="false" にしている理由:
          記録には自宅と職場のGPS軌跡が含まれる。既定のままだと
          Googleドライブへ自動バックアップされてしまうので、端末の外に出さない。
          機種変更のときは集計画面からxlsxを書き出すか、READMEのadbバックアップ手順を使う。
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".location.TrackService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
